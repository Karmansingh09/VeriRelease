# ==============================================================================
# VeriRelease — Environment Configuration Template
# ==============================================================================
# Copy this file to .env.local for local development.
# NEVER commit .env, .env.local, or any actual credentials to source control.
# In production, all required variables must be set with zero fallback defaults.
# ==============================================================================

# Node Environment ('development' | 'test' | 'production')
NODE_ENV=development

# Application Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# Database (PostgreSQL)
# ------------------------------------------------------------------------------
# Format: postgresql://<user>:<password>@<host>:<port>/<database>?schema=<schema>
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/verirelease?schema=public

# ------------------------------------------------------------------------------
# GitHub Integration (Milestones & Webhooks)
# ------------------------------------------------------------------------------
# GitHub Webhook HMAC secret used to verify incoming payloads (x-hub-signature-256)
GITHUB_WEBHOOK_SECRET=your_github_webhook_secret_here

# GitHub Personal Access Token or App Token for read-only PR diff and check retrieval
GITHUB_ACCESS_TOKEN=your_github_access_token_here

# ------------------------------------------------------------------------------
# OpenAI API (Evidence Evaluator)
# ------------------------------------------------------------------------------
# OpenAI API Key used strictly for structured criteria evaluation (Read-only domain)
OPENAI_API_KEY=sk-proj-your_openai_api_key_here
OPENAI_MODEL=gpt-4o-2024-08-06

# ------------------------------------------------------------------------------
# PayPal Sandbox API (Payment Coordination)
# ------------------------------------------------------------------------------
# PayPal REST API credentials (Sandbox mode during development and hackathon)
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret
PAYPAL_WEBHOOK_ID=your_paypal_webhook_id
