# ==============================================================================
# VeriRelease — Environment Configuration Template
# ==============================================================================
# Copy this file to .env.local for local development.
# NEVER commit .env, .env.local, or any actual credentials to source control.
# In production, all required variables must be set with zero fallback defaults.
# ==============================================================================

# Node Environment ('development' | 'test' | 'production')
NODE_ENV=development

# Application Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# Authentication
# ------------------------------------------------------------------------------
# Secret key used strictly for signing and verifying VeriRelease bearer tokens.
# Must NOT reuse GITHUB_WEBHOOK_SECRET. In production, minimum 32 characters.
AUTH_TOKEN_SIGNING_SECRET=your_auth_token_signing_secret_here_min_32_chars

# ------------------------------------------------------------------------------
# Database (PostgreSQL)
# ------------------------------------------------------------------------------
# Format: postgresql://<user>:<password>@<host>:<port>/<database>?schema=<schema>
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/verirelease?schema=public

# ------------------------------------------------------------------------------
# GitHub Integration (Milestones & Webhooks)
# ------------------------------------------------------------------------------
# GitHub Webhook HMAC secret used to verify incoming payloads (x-hub-signature-256)
GITHUB_WEBHOOK_SECRET=your_github_webhook_secret_here

# GitHub Personal Access Token or App Token for read-only PR diff and check retrieval
GITHUB_ACCESS_TOKEN=your_github_access_token_here

# GitHub API Base URL (defaults to https://api.github.com)
GITHUB_API_BASE_URL=https://api.github.com

# GitHub App Configuration (optional if using GitHub App instead of Personal Access Token)
GITHUB_APP_ID=your_github_app_id_here
GITHUB_INSTALLATION_ID=your_github_installation_id_here
GITHUB_PRIVATE_KEY=your_github_private_key_pem_here

# ------------------------------------------------------------------------------
# GitHub OAuth 2.0 Web Application Flow (Milestone 3.1)
# ------------------------------------------------------------------------------
# Dedicated OAuth 2.0 Client credentials registered in GitHub Developer Settings.
# Must NOT reuse GITHUB_APP_ID or GITHUB_WEBHOOK_SECRET.
# Callback URL must use HTTPS in production.
GITHUB_OAUTH_CLIENT_ID=your_github_oauth_client_id_here
GITHUB_OAUTH_CLIENT_SECRET=your_github_oauth_client_secret_here
GITHUB_OAUTH_CALLBACK_URL=http://localhost:3000/api/auth/github/callback

# ------------------------------------------------------------------------------
# OpenAI API (Evidence Evaluator)
# ------------------------------------------------------------------------------
# OpenAI API Key used strictly for structured criteria evaluation (Read-only domain)
OPENAI_API_KEY=sk-proj-your_openai_api_key_here
OPENAI_MODEL=gpt-4o-2024-08-06

# ------------------------------------------------------------------------------
# PayPal Sandbox API (Payment Coordination)
# ------------------------------------------------------------------------------
# PayPal REST API credentials (Sandbox mode during development and hackathon)
PAYPAL_MODE=sandbox
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret
PAYPAL_WEBHOOK_ID=your_paypal_webhook_id
